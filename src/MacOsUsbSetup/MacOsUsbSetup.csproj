<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>setup</AssemblyName>
    <RootNamespace>MacOsUsbSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- One self-contained file that runs without an installed .NET runtime. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF creates the UI CultureInfo (FrameworkElement.Language, default en-US) at render
         time; globalization-invariant mode makes that throw CultureNotFoundException and the
         window never appears. Keep full globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- build.ps1 assembles this from upstream OpenCore/kext releases before publish. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\efi-payload.zip" Condition="Exists('Assets\efi-payload.zip')">
      <LogicalName>efi-payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
