<UserControl x:Class="MacOsUsbSetup.App.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource Danger}" />
        <TextBlock Grid.Row="1" Text="{Binding StageText, StringFormat=Schritt: {0}}"
                   Foreground="{StaticResource Text.Muted}" Margin="0,6,0,16" />

        <TextBlock Grid.Row="2" Text="{Binding Message}" FontSize="14" />

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="14,12" CornerRadius="4"
                Background="{StaticResource Surface.Panel}" BorderBrush="{StaticResource Badge.Experimental}" BorderThickness="1"
                Visibility="{Binding HasRemedy, Converter={StaticResource BoolToVisible}}">
            <TextBlock Text="{Binding Remedy, StringFormat=Empfehlung: {0}}" />
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Primary}" Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource Ghost}" Content="Protokoll anzeigen" Command="{Binding ShowLogCommand}" Margin="0,0,10,0" />
            <Button Style="{StaticResource Ghost}" Content="Beenden" Command="{Binding QuitCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
