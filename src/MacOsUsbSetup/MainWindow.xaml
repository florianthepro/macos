<Window x:Class="MacOsUsbSetup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MacOsUsbSetup.App.ViewModels"
        xmlns:views="clr-namespace:MacOsUsbSetup.App.Views"
        Title="macOS USB Setup" Height="640" Width="920" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Window}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionViewModel}"><views:VersionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsbViewModel}"><views:UsbView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WriteViewModel}"><views:WriteView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DoneViewModel}"><views:DoneView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorViewModel}"><views:ErrorView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface.Header}"
                BorderBrush="{StaticResource Surface.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="macOS USB Setup" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Bootfähigen macOS-Installations-Stick erstellen"
                           FontSize="12" Foreground="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
